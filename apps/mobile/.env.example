# WALLORA environment variables
# Copy to .env.local (web) / .env (worker) and fill in real values. Never commit secrets.

NODE_ENV=development

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Database (Neon PostgreSQL)
DATABASE_URL=
WORKER_DATABASE_URL=

# Auth (Better Auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# NVIDIA NIM
NVIDIA_API_KEY=

# Worker
WORKER_SECRET=

# Email
EMAIL_PROVIDER_API_KEY=

# Payments (research before enabling)
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
