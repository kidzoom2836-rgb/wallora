{
  "expo": {
    "name": "WALLORA",
    "slug": "wallora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "wallora",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.wallora.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "WALLORA uses your photos so you can share images with the community.",
          "cameraPermission": "WALLORA uses the camera so you can take and share photos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "WALLORA saves wallpapers to your gallery so you can set them on your device.",
          "savePhotosPermission": "WALLORA saves wallpapers to your gallery so you can set them on your device.",
          "granularPermissions": ["photo"]
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D7B879",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      "./plugins/withCleartextTraffic.js",
      "expo-asset"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "99de0eeb-2250-4d01-89e1-c82f8987b500"
      }
    },
    "owner": "skyjackson"
  }
}
