DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&pgbouncer=true&connect_timeout=15"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Optional storage (falls back to Postgres StoredBlob when unset)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_BASE_URL=""
BLOB_READ_WRITE_TOKEN=""

# Optional NVIDIA NIM key — enables NVIDIA text + image models selected in /adminkenya
NVIDIA_API_KEY=""

# Optional Pixabay key for the super-admin wallpaper importer and Reels proxy.
# Used server-side only by POST /api/v1/admin/wallpapers/import/pixabay and
# GET /api/v1/reels/search. Never expose it to the mobile bundle.
PIXABAY_API_KEY=""

# Optional server-side Reels provider keys. The mobile app calls
# /api/v1/reels/search and never receives these values.
YOUTUBE_API_KEY=""
PEXELS_API_KEY=""

# Password reset email delivery (Resend REST API; no server SDK dependency)
# On Vercel, NEXT_PUBLIC_APP_URL should be https://wallora-inky.vercel.app.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
RESEND_API_KEY=""
WALLORA_EMAIL_FROM="WALLORA <onboarding@resend.dev>"

# Optional Expo push access token. Only required if push security is enabled
# in the Expo dashboard; the documented push API works without it by default.
EXPO_ACCESS_TOKEN=""
