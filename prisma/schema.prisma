// WALLORA — Prisma schema
// Phase 2: Authentication & database foundation.
//
// Database: PostgreSQL on Neon (serverless-friendly, pooled via PgBouncer for
// the app runtime, direct connection for migrations). The model design is
// identical to the earlier SQLite variant — only the datasource provider
// changed. Hosting target: Vercel.
//
// NextAuth v4 is used with the JWT session strategy (no Prisma adapter
// required for the credentials provider). The User model carries a password
// hash for credentials auth plus WALLORA domain fields (role, profile link).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Authentication & identity
// ---------------------------------------------------------------------------

/// WALLORA user. Combines NextAuth-compatible fields (email, emailVerified,
/// image, name) with WALLORA domain fields (passwordHash, role, status).
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  role          String    @default("user") // guest|user|creator|moderator|admin|super_admin
  status        String    @default("active") // active|suspended|deleted
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile       Profile?
  settings      UserSettings?
  waitlistEntries WaitlistEntry[]
  wallpapers    Wallpaper[]
  likes         WallpaperLike[]
  favorites     Favorite[]
  downloads     WallpaperDownload[]
  collections   Collection[]
  conversations AiConversation[]
  usageLedger   UsageLedger[]
  generations   AiGeneration[]
  projects      CreativeProject[]
  comments      Comment[]
  following     Follow[]       @relation("Follower")
  followers     Follow[]       @relation("Following")
  products      Product[]
  purchases     Purchase[]

  @@index([role])
  @@index([status])
}

/// Public profile shown on /profile/[username]. One-to-one with User.
model Profile {
  id            String    @id @default(cuid())
  userId        String    @unique
  username      String    @unique
  displayName   String?
  bio           String?
  avatarUrl     String?
  coverUrl      String?
  verified      Boolean   @default(false)
  creatorStatus String    @default("none") // none|pending|approved|rejected
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([username])
  @@index([creatorStatus])
}

/// Per-user application settings (appearance, notifications, AI prefs).
model UserSettings {
  id                       String    @id @default(cuid())
  userId                   String    @unique
  theme                    String    @default("dark") // dark|light|system
  emailNotifications       Boolean   @default(true)
  pushNotifications        Boolean   @default(false)
  aiPreferenceMode         String    @default("creative-assistant")
  preferredImageStyles     String    @default("")
  preferredCategories      String    @default("")
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Early access (Phase 1)
// ---------------------------------------------------------------------------

/// Early-access waitlist entries captured from the WALLORA landing page.
model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  intent    String   @default("general") // creator|explorer|studio|general
  prompt    String?
  message   String?
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([intent])
  @@index([createdAt])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Audit (Phase 2 minimal — expanded in later phases)
// ---------------------------------------------------------------------------

/// Append-only audit log for sensitive actions (auth, role changes, admin).
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  targetType String?
  targetId  String?
  metadata  String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Discovery — categories, tags, wallpapers (Phase 3)
// ---------------------------------------------------------------------------

/// A discovery category (Nature, Technology, Architecture, …). Seeded, not
/// user-editable until the admin dashboard ships.
model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  icon        String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  wallpapers  Wallpaper[]

  @@index([slug])
  @@index([sortOrder])
}

/// A free-form tag applied to wallpapers. Created on demand during seeding /
/// upload. Tags are lowercase, unique by slug.
model Tag {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  wallpapers WallpaperTag[]

  @@index([slug])
}

/// A wallpaper record. Owns asset variants, tags, interactions.
/// Denormalized counters (likeCount, downloadCount, favoriteCount, viewCount)
/// are updated atomically on interaction create/delete.
model Wallpaper {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  description    String?
  userId         String   // creator
  categoryId     String?
  status         String   @default("approved") // pending|approved|rejected|flagged|removed
  license        String   @default("WALLORA Showcase") // CC0|Personal|Commercial|WALLORA Showcase
  orientation    String   @default("landscape") // portrait|landscape|square
  dominantColor  String?  // hex, e.g. #D7B879
  sourceType     String   @default("showcase") // showcase|upload|generated
  isPublic       Boolean  @default(true)
  viewCount      Int      @default(0)
  likeCount      Int      @default(0)
  downloadCount  Int      @default(0)
  favoriteCount  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  assets         WallpaperAsset[]
  tags           WallpaperTag[]
  likes          WallpaperLike[]
  downloads      WallpaperDownload[]
  favorites      Favorite[]
  collectionItems CollectionItem[]
  comments       Comment[]

  @@index([userId])
  @@index([categoryId])
  @@index([status])
  @@index([orientation])
  @@index([isPublic])
  @@index([createdAt])
  @@index([likeCount])
  @@index([downloadCount])
}

/// A single asset variant for a wallpaper (thumbnail, grid, detail, mobile,
/// desktop, original). objectKey is a public path now, swappable for an R2
/// key in Phase 4 without schema changes.
model WallpaperAsset {
  id           String   @id @default(cuid())
  wallpaperId  String
  variant      String   // thumbnail|grid|detail|mobile|desktop|original
  objectKey    String   // public path now, R2 key later
  width        Int
  height       Int
  fileSize     Int      @default(0)
  format       String   @default("jpg")
  mimeType     String   @default("image/jpeg")
  createdAt    DateTime @default(now())

  wallpaper    Wallpaper @relation(fields: [wallpaperId], references: [id], onDelete: Cascade)

  @@unique([wallpaperId, variant])
  @@index([wallpaperId])
  @@index([variant])
}

/// Join table: wallpaper ↔ tag.
model WallpaperTag {
  id          String   @id @default(cuid())
  wallpaperId String
  tagId       String
  createdAt   DateTime @default(now())

  wallpaper   Wallpaper @relation(fields: [wallpaperId], references: [id], onDelete: Cascade)
  tag         Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([wallpaperId, tagId])
  @@index([wallpaperId])
  @@index([tagId])
}

/// A like on a wallpaper. Unique per (user, wallpaper) — toggling deletes.
model WallpaperLike {
  id          String   @id @default(cuid())
  wallpaperId String
  userId      String
  createdAt   DateTime @default(now())

  wallpaper   Wallpaper @relation(fields: [wallpaperId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([wallpaperId, userId])
  @@index([wallpaperId])
  @@index([userId])
}

/// A download event. Append-only — one row per download (not toggled).
model WallpaperDownload {
  id          String   @id @default(cuid())
  wallpaperId String
  userId      String?
  variant     String   @default("original")
  createdAt   DateTime @default(now())

  wallpaper   Wallpaper @relation(fields: [wallpaperId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([wallpaperId])
  @@index([userId])
  @@index([createdAt])
}

/// A favorite (save). Unique per (user, wallpaper) — toggling deletes.
model Favorite {
  id          String   @id @default(cuid())
  wallpaperId String
  userId      String
  createdAt   DateTime @default(now())

  wallpaper   Wallpaper @relation(fields: [wallpaperId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([wallpaperId, userId])
  @@index([wallpaperId])
  @@index([userId])
}

/// A user-created named collection of wallpapers.
model Collection {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  isPublic    Boolean  @default(false)
  coverUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       CollectionItem[]

  @@index([userId])
  @@index([isPublic])
}

/// An item in a collection.
model CollectionItem {
  id           String   @id @default(cuid())
  collectionId String
  wallpaperId  String
  createdAt    DateTime @default(now())

  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  wallpaper    Wallpaper  @relation(fields: [wallpaperId], references: [id], onDelete: Cascade)

  @@unique([collectionId, wallpaperId])
  @@index([collectionId])
  @@index([wallpaperId])
}

// ---------------------------------------------------------------------------
// AI conversation engine (Phase 5)
// ---------------------------------------------------------------------------

/// A conversation between a user and WALLORA AI. Owned by the user.
model AiConversation {
  id           String    @id @default(cuid())
  userId       String
  title        String    @default("New conversation")
  mode         String    @default("creative-assistant")
  messageCount Int       @default(0)
  lastMessageAt DateTime @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     AiMessage[]

  @@index([userId])
  @@index([mode])
  @@index([lastMessageAt])
}

/// A message in an AI conversation. role is user|assistant.
model AiMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // user|assistant
  content        String
  tokens         Int      @default(0)
  createdAt      DateTime @default(now())

  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

/// Append-only usage ledger for quota tracking. Every AI operation records
/// credits consumed. The quota system counts today's entries per user.
model UsageLedger {
  id             String   @id @default(cuid())
  userId         String
  action         String   // ai_message|ai_enhance|ai_generate|ai_analyze
  creditsUsed    Int      @default(1)
  conversationId String?
  messageId      String?
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// AI Studio — image generation (Phase 6)
// ---------------------------------------------------------------------------

/// A generation job. Tracks the full lifecycle:
/// queued → processing → completed | failed | cancelled.
/// Credits are reserved before generation and refunded on failure.
model AiGeneration {
  id             String   @id @default(cuid())
  userId         String
  prompt         String
  enhancedPrompt String?
  stylePreset    String   @default("none")
  aspectRatio    String   @default("square") // square|portrait|landscape
  size           String   @default("1024x1024")
  status         String   @default("queued") // queued|processing|completed|failed|cancelled
  provider       String   @default("zai")
  model          String   @default("default")
  objectKey      String?
  publicUrl      String?
  width          Int      @default(0)
  height         Int      @default(0)
  fileSize       Int      @default(0)
  creditsUsed    Int      @default(5)
  errorMessage   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([stylePreset])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Creative projects (Phase 7)
// ---------------------------------------------------------------------------

model CreativeProject {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  coverUrl    String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets      ProjectAsset[]
  notes       ProjectNote[]

  @@index([userId])
  @@index([isPublic])
}

model ProjectAsset {
  id           String   @id @default(cuid())
  projectId    String
  wallpaperId  String?
  generationId String?
  assetType    String   @default("wallpaper") // wallpaper|generation
  note         String?
  createdAt    DateTime @default(now())

  project      CreativeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectNote {
  id        String   @id @default(cuid())
  projectId String
  content   String
  createdAt DateTime @default(now())

  project   CreativeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Community (Phase 8)
// ---------------------------------------------------------------------------

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Comment {
  id          String   @id @default(cuid())
  wallpaperId String
  userId      String
  content     String
  createdAt   DateTime @default(now())

  wallpaper   Wallpaper @relation(fields: [wallpaperId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([wallpaperId])
  @@index([userId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Marketplace (Phase 9)
// ---------------------------------------------------------------------------

model Product {
  id          String   @id @default(cuid())
  creatorId   String
  title       String
  description String?
  price       Int      @default(0) // in cents
  license     String   @default("Personal")
  coverUrl    String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator     User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  purchases   Purchase[]

  @@index([creatorId])
  @@index([isPublished])
}

model Purchase {
  id        String   @id @default(cuid())
  userId    String
  productId String
  price     Int
  status    String   @default("completed") // pending|completed|failed|refunded
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Database-backed object storage (fallback when no Blob/R2 is configured)
// ---------------------------------------------------------------------------

/// Stores uploaded image binaries directly in Postgres (bytea). Used by the
/// DatabaseStorageAdapter when neither Cloudflare R2 nor Vercel Blob env vars
/// are set — so uploads work immediately with just the database, no extra
/// storage service required. For high-volume deployments, switch to R2 or
/// Blob by setting their env vars (the adapter changes automatically).
model StoredBlob {
  id          String   @id @default(cuid())
  key         String   @unique
  data        Bytes
  contentType String   @default("image/jpeg")
  size        Int      @default(0)
  createdAt   DateTime @default(now())
}
